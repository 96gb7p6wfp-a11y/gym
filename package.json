{
  "name": "setline-gym",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "web": "vite",
    "build": "tsc --noEmit && vite build && node scripts/finalize-web.mjs",
